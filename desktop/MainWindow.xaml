<Window x:Class="TaskManager.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:TaskManager.Desktop.Properties"
        Title="{x:Static properties:Strings.TaskManager}" Height="680" Width="1040" MinHeight="560" MinWidth="800"
        WindowStartupLocation="CenterScreen" Background="#F5F7FA" FlowDirection="RightToLeft">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="{x:Static properties:Strings.TaskManager}" FontSize="28" FontWeight="SemiBold" Foreground="#172B4D" />
            <TextBlock Text="{x:Static properties:Strings.DesktopSubtitle}"
                       Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Border x:Name="LoginPanel" Background="White" CornerRadius="10" Padding="28"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Width="460">
                <StackPanel>
                    <TextBlock Text="{x:Static properties:Strings.SignIn}" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,14" />
                    <TextBlock Text="{x:Static properties:Strings.ApiBaseUrl}" />
                    <TextBox Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                             FlowDirection="LeftToRight" TextAlignment="Left"
                             ToolTip="{x:Static properties:Strings.ApiUrlToolTip}" />
                    <TextBlock Text="{x:Static properties:Strings.FirstName}"
                               Visibility="{Binding IsRegistering, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsRegistering, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{x:Static properties:Strings.LastName}"
                               Visibility="{Binding IsRegistering, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsRegistering, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{x:Static properties:Strings.Email}" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             FlowDirection="LeftToRight" TextAlignment="Left" />
                    <TextBlock Text="{x:Static properties:Strings.Password}" />
                    <PasswordBox x:Name="LoginPassword" FlowDirection="LeftToRight" Padding="9,7" Margin="0,5,0,16"
                                 PasswordChanged="LoginPassword_OnPasswordChanged" />
                    <TextBlock Text="{x:Static properties:Strings.ConfirmPassword}"
                               Visibility="{Binding IsRegistering, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <PasswordBox x:Name="ConfirmRegistrationPassword" FlowDirection="LeftToRight"
                                 Padding="9,7" Margin="0,5,0,16"
                                 PasswordChanged="ConfirmRegistrationPassword_OnPasswordChanged"
                                 Visibility="{Binding IsRegistering, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Content="{Binding AuthenticationActionLabel}" Command="{Binding LoginCommand}"
                            Background="{StaticResource AccentBrush}" Foreground="White"
                            HorizontalAlignment="Right" />
                    <Button Content="{x:Static properties:Strings.ForgotPassword}" Command="{Binding ForgotPasswordCommand}"
                            HorizontalAlignment="Right"
                            Visibility="{Binding IsNotRegistering, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Content="{Binding RegistrationToggleLabel}" Command="{Binding ToggleRegistrationCommand}"
                            HorizontalAlignment="Right" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#B42318" TextWrapping="Wrap"
                               Margin="0,12,0,0" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Grid x:Name="WorkspacePanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,14">
                    <StackPanel DockPanel.Dock="Right">
                        <TextBlock Text="{Binding WelcomeMessage}" FontSize="18" FontWeight="SemiBold"
                                   Foreground="#172B4D" />
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <Button DockPanel.Dock="Left" Content="{x:Static properties:Strings.LogOut}" Command="{Binding LogoutCommand}"
                            Margin="8,0,0,0" />
                    <Button DockPanel.Dock="Left" Content="{x:Static properties:Strings.ShowTasks}" Command="{Binding ShowTasksCommand}"
                            Visibility="{Binding IsManager, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="8,0,0,0" />
                    <Button DockPanel.Dock="Left" Content="{x:Static properties:Strings.UserManagement}" Command="{Binding ManageUsersCommand}"
                            Visibility="{Binding IsManager, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="8,0,0,0" />
                    <Button DockPanel.Dock="Left" Content="{x:Static properties:Strings.RegistrationRequests}" Command="{Binding ShowRegistrationRequestsCommand}"
                            Visibility="{Binding IsManager, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="8,0,0,0" />
                    <Button DockPanel.Dock="Left" Content="{x:Static properties:Strings.Refresh}" Command="{Binding RefreshCommand}" />
                </DockPanel>

                <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="#B42318"
                           TextWrapping="Wrap" Margin="0,0,0,12" />

                <Grid x:Name="TaskManagementPanel" Grid.Row="2"
                      Visibility="{Binding IsTaskManagement, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="{x:Static properties:Strings.MyTasks}" FontSize="17" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Button Content="{x:Static properties:Strings.NewTask}" Command="{Binding NewTaskCommand}"
                                        Margin="8,0,0,0" />
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}"
                                     BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#EAECF0" BorderThickness="0,0,0,1"
                                                Padding="8,12">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Description}" Foreground="#667085"
                                                           TextWrapping="Wrap" MaxHeight="42" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding OwnerName}" Foreground="#667085"
                                                           Visibility="{Binding DataContext.IsManager, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                           Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding CompletionLabel}" FontSize="11"
                                                           Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="{Binding EditorHeading}" FontSize="17" FontWeight="SemiBold"
                                       Margin="0,0,0,12" />
                            <TextBlock Text="{x:Static properties:Strings.Title}" />
                            <TextBox Text="{Binding EditorTitle, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="255" />
                            <TextBlock Text="{x:Static properties:Strings.Description}" />
                            <TextBox Text="{Binding EditorDescription, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Height="150" MaxLength="5000" />
                            <TextBlock Text="{x:Static properties:Strings.SelectUser}" Margin="0,10,0,2"
                                       Visibility="{Binding IsManager, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ComboBox ItemsSource="{Binding Users}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedTaskOwnerId, Mode=TwoWay}"
                                      Visibility="{Binding IsManager, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Text="{Binding SelectedTask.CompletionLabel}"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14" />
                            <WrapPanel>
                                <Button Content="{x:Static properties:Strings.SaveTask}" Command="{Binding SaveTaskCommand}"
                                        Background="{StaticResource AccentBrush}" Foreground="White" />
                                <Button Content="{Binding ToggleCompletionLabel}" Command="{Binding ToggleCompletionCommand}" />
                                <Button Content="{x:Static properties:Strings.Delete}" Command="{Binding DeleteTaskCommand}" />
                            </WrapPanel>
                            <TextBlock Text="{x:Static properties:Strings.ChooseOrCreateTask}"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="UsersManagementPanel" Grid.Row="2"
                      Visibility="{Binding IsUserManagement, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16">
                        <DockPanel>
                            <Button DockPanel.Dock="Top" Content="{x:Static properties:Strings.AddUser}"
                                    Command="{Binding NewUserCommand}" HorizontalAlignment="Right" Margin="0,0,0,12" />
                            <ListBox ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                                     BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#EAECF0" BorderThickness="0,0,0,1" Padding="8,12">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Email}" FlowDirection="LeftToRight"
                                                           TextAlignment="Left" Foreground="#667085" />
                                                <TextBlock Text="{Binding RoleLabel}" Foreground="{StaticResource MutedBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="{Binding UserEditorHeading}" FontSize="17" FontWeight="SemiBold"
                                       Margin="0,0,0,12" />
                            <TextBlock Text="{x:Static properties:Strings.Name}" />
                            <TextBox Text="{Binding UserEditorName, UpdateSourceTrigger=PropertyChanged}" MaxLength="255" />
                            <TextBlock Text="{x:Static properties:Strings.Email}" />
                            <TextBox Text="{Binding UserEditorEmail, UpdateSourceTrigger=PropertyChanged}"
                                     FlowDirection="LeftToRight" TextAlignment="Left" MaxLength="255" />
                            <TextBlock Text="{x:Static properties:Strings.Password}" />
                            <PasswordBox x:Name="UserPassword" FlowDirection="LeftToRight" Padding="9,7" Margin="0,5,0,10"
                                         PasswordChanged="UserPassword_OnPasswordChanged" />
                            <CheckBox Content="{x:Static properties:Strings.Manager}" IsChecked="{Binding UserEditorIsManager}"
                                      Margin="0,0,0,12" />
                            <Button Content="{x:Static properties:Strings.SaveUser}" Command="{Binding SaveUserCommand}"
                                    Background="{StaticResource AccentBrush}" Foreground="White" />
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#B42318" TextWrapping="Wrap"
                                       Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="RegistrationManagementPanel" Grid.Row="2"
                      Visibility="{Binding IsRegistrationManagement, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Background="White" CornerRadius="8" Padding="16">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{x:Static properties:Strings.RegistrationRequests}"
                                       FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <ListBox ItemsSource="{Binding RegistrationRequests}"
                                     SelectedItem="{Binding SelectedRegistrationRequest}"
                                     BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#EAECF0" BorderThickness="0,0,0,1"
                                                Padding="8,12">
                                            <DockPanel LastChildFill="False">
                                                <StackPanel DockPanel.Dock="Right">
                                                    <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Email}" FlowDirection="LeftToRight"
                                                               TextAlignment="Left" Foreground="#667085" />
                                                    <TextBlock Text="{Binding StatusLabel}" Foreground="{StaticResource MutedBrush}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                <Button Content="{x:Static properties:Strings.Approve}"
                                        Command="{Binding ApproveRegistrationRequestCommand}"
                                        Background="{StaticResource AccentBrush}" Foreground="White" />
                                <Button Content="{x:Static properties:Strings.Reject}"
                                        Command="{Binding RejectRegistrationRequestCommand}" />
                                <Button Content="{x:Static properties:Strings.Refresh}"
                                        Command="{Binding ShowRegistrationRequestsCommand}" />
                            </WrapPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
