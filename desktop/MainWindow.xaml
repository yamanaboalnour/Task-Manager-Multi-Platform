<Window x:Class="TaskManager.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Manager" Height="680" Width="1040" MinHeight="560" MinWidth="800"
        WindowStartupLocation="CenterScreen" Background="#F5F7FA">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="Task Manager" FontSize="28" FontWeight="SemiBold" Foreground="#172B4D" />
            <TextBlock Text="A desktop client for your Laravel task workspace"
                       Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Border x:Name="LoginPanel" Background="White" CornerRadius="10" Padding="28"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Width="460">
                <StackPanel>
                    <TextBlock Text="Sign in" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,14" />
                    <TextBlock Text="API base URL" />
                    <TextBox Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Laravel server root, for example http://127.0.0.1:8000" />
                    <TextBlock Text="Email" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Password" />
                    <PasswordBox x:Name="LoginPassword" Padding="9,7" Margin="0,5,0,16"
                                 PasswordChanged="LoginPassword_OnPasswordChanged" />
                    <Button Content="Sign in" Command="{Binding LoginCommand}"
                            Background="{StaticResource AccentBrush}" Foreground="White"
                            HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#B42318" TextWrapping="Wrap"
                               Margin="0,12,0,0" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Grid x:Name="WorkspacePanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,14">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="{Binding WelcomeMessage}" FontSize="18" FontWeight="SemiBold"
                                   Foreground="#172B4D" />
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Content="Log out" Command="{Binding LogoutCommand}"
                            Margin="8,0,0,0" />
                    <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" />
                </DockPanel>

                <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="#B42318"
                           TextWrapping="Wrap" Margin="0,0,0,12" />

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Your tasks" FontSize="17" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Button Content="New task" Command="{Binding NewTaskCommand}"
                                        Margin="8,0,0,0" />
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}"
                                     BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#EAECF0" BorderThickness="0,0,0,1"
                                                Padding="8,12">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Description}" Foreground="#667085"
                                                           TextWrapping="Wrap" MaxHeight="42" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding CompletionLabel}" FontSize="11"
                                                           Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="{Binding EditorHeading}" FontSize="17" FontWeight="SemiBold"
                                       Margin="0,0,0,12" />
                            <TextBlock Text="Title" />
                            <TextBox Text="{Binding EditorTitle, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="255" />
                            <TextBlock Text="Description" />
                            <TextBox Text="{Binding EditorDescription, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Height="150" MaxLength="5000" />
                            <TextBlock Text="{Binding SelectedTask.CompletionLabel}"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14" />
                            <WrapPanel>
                                <Button Content="Save task" Command="{Binding SaveTaskCommand}"
                                        Background="{StaticResource AccentBrush}" Foreground="White" />
                                <Button Content="Toggle complete" Command="{Binding ToggleCompletionCommand}" />
                                <Button Content="Delete" Command="{Binding DeleteTaskCommand}" />
                            </WrapPanel>
                            <TextBlock Text="Choose a task or create one to begin."
                                       Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
